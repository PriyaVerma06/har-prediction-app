# Groq Cloud API Key for AI biomechanical motion insights
# Obtain a free key from: https://console.groq.com/keys
#
# For Local Development:
# Copy this file to backend/.env and insert your key.
#
# For Hugging Face Spaces:
# Add this in Space Settings -> Variables and secrets -> New secret:
# Name: GROQ_API_KEY
# Value: gsk_...
GROQ_API_KEY=gsk_your_groq_api_key_here
